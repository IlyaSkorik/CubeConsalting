{
  "name": "cubeconsalting",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev:desktop": "tailwindcss -i ./static/src/desktop.css -o ./static/desktop/css/desktop.css --watch",
    "dev:mobile": "tailwindcss -i ./static/src/mobile.css -o ./static/mobile/css/mobile.css --watch",
    "build": "tailwindcss -i ./static/src/desktop.css -o ./static/desktop/css/desktop.css --minify && tailwindcss -i ./static/src/mobile.css -o ./static/mobile/css/mobile.css --minify",
    "build:three": "esbuild static/desktop/js/three-hero.js --bundle --outfile=static/desktop/js/three-hero.bundled.js --format=esm --minify && esbuild static/desktop/js/solutions-3d.js --bundle --outfile=static/desktop/js/solutions-3d.bundled.js --format=esm --minify",
    "build:assets": "npm run build && npm run build:three"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IlyaSkorik/CubeConsalting.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/IlyaSkorik/CubeConsalting/issues"
  },
  "homepage": "https://github.com/IlyaSkorik/CubeConsalting#readme",
  "dependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "gsap": "^3.15.0",
    "tailwindcss": "^4.3.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  }
}
