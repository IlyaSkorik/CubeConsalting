      "optional": true
    },
    "@react-three/fiber": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-three/fiber": "^9.6.1",
    "@types/react": "^19.2.17",
    "@types/three": "^0.184.0",
    "react": "^19.2.7",
